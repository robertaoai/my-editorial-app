      "label": "Audit Model and Gap Remediation Plan",
      "file_type": "document",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "",
      "description": "Adopts a CPA-style audit model in which issued reports are immutable and the record is insert and read only. Contains gaps GA1-GA9, a table-by-table retention review, the policy/control/disposal separation, and eleven remediation steps.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "tenancy_boundary_decision",
      "label": "Tenancy Boundary Decision (Q10 answered)",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-consolidated-gaps-and-open-questions.md",
      "source_location": "section 2 item 7",
      "description": "Chief Editor decision of 2026-08-18 to include a tenancy boundary in the S1 schema. Each paying POC customer is its own tenant, never grouped by shared company email domain, for platform indemnity and issue isolation. Authorizes the boundary only, not any multi-tenant feature.",
      "community": 28,
      "community_name": "Sprint Readiness and Board Approvals"
    },
    {
      "id": "single_revenue_rule",
      "label": "Single Revenue Rule",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-poc-charter-separation-and-revenue-model.md",
      "source_location": "section 4.2",
      "description": "Revenue may attach to the business and to the service, but never to a specific editorial decision. Satisfies NG-03 by keeping payment outside the application and NG-11 by never tying solicitation to a particular story or verdict.",
      "community": 28,
      "community_name": "Sprint Readiness and Board Approvals"
    },
    {
      "id": "cr15_resolved_by_charter_separation",
      "label": "CR-15 Resolved by Charter Separation",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-poc-charter-separation-and-revenue-model.md",
      "source_location": "section 1",
      "description": "CR-15's single Chief Editor account governs the anchor MVP project and remains satisfied unchanged. The client-facing POC sits under a separate charter and was never within CR-15's scope, so no change request or Charter act is required.",
      "community": 28,
      "community_name": "Sprint Readiness and Board Approvals"
    },
    {
      "id": "g7a_g7b_sequencing_split",
      "label": "G7a/G7b — Manual Lane versus Systematized Exposure",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-consolidated-gaps-and-open-questions.md",
      "source_location": "section 6.1",
      "description": "Splits the P0-EVR charter work by dependency profile. G7a charters the manual lane and needs no build, unblocking commercial evidence. G7b is the systematized client exposure, depending on S1 and S2 with enforcement completing at S6 under SEC-03.",
      "community": 28,
      "community_name": "Sprint Readiness and Board Approvals"
    },
    {
      "id": "s1_migration_decision_window",
      "label": "S1 Migration Decision Window",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "section 4",
      "description": "Seven decisions that alter the same append-only table and must be settled as one design: Q10 (answered), Q11, QA3, report record shape, the insert/read-only table list, retention floor and classification, and cascade behaviour.",
      "community": 28,
      "community_name": "Sprint Readiness and Board Approvals"
    },
    {
      "id": "statutory_retention_floor",
      "label": "Statutory Retention Floor",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "Step 6",
      "description": "Stated basis that Singapore law requires financial and accounting records to be retained at least five years under IRAS and ACRA. Bounds the retention question for years 0-5 but supplies no basis for indefinite retention.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "ga5_retention_erasure_conflict",
      "label": "GA5 — Retention versus Erasure Conflict",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "section 2",
      "description": "Modular_PRD section 6.3 states workflow_transitions is never deleted while SEC-04 requires GDPR Article 17 erasure and PDPA applies directionally to the POC lane. These cannot all hold. SEC-04 and SEC-05 are unowned, so the remainder is escalated to external counsel.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "ga6_assertion_versus_audit_opinion",
      "label": "GA6 — Management Assertion versus Audit Opinion",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "section 2",
      "description": "The Chief Editor's Publish, Hold, or Escalate disposition is a management assertion. No independent audit opinion exists in the model, so management currently both prepares and signs off, the collision independent assurance exists to prevent.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "ga9_cascade_contradicts_nfr02",
      "label": "GA9 — on delete cascade contradicts NFR-02",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "section 7.2",
      "description": "0001_init.sql defines workflow_transitions.article_id with on delete cascade, so deleting or archiving an article silently deletes every transition row NFR-02 declares must never be deleted. A live contradiction in applied SQL, resolvable by on delete restrict in migration 0002.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "event_type_intent_vocabulary",
      "label": "event_type and Intent Code Vocabulary",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-transition-intent-vocabulary.md",
      "source_location": "sections 2-4",
      "description": "Two-level controlled vocabulary. event_type records the kind of state change; an intent code records the editorial ground. Reuses the already-planned event_type field rather than minting a synonym, and keeps the free-text reason alongside.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "psk10_immutable_audit_reporting",
      "label": "PSK-10 — Immutable Audit Reporting",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "Step 1",
      "description": "Proposed Project Scope key registering CPA-style audit reporting and report reproducibility. No Customer Request asks for it, so without a key it becomes undisclosed funded scope, the defect FB-04 named.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "disposal_record_control",
      "label": "Disposal Record Control",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "section 6.3",
      "description": "Because every disposal mechanism bypasses the protection it removes data from, disposal must produce its own immutable record written beforehand and stored outside the disposed table, naming scope, policy version, authorizing party, date, mechanism, and archive location.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    },
    {
      "id": "archival_policy_challenge",
      "label": "Archival Intent Policy Challenge",
      "file_type": "concept",
      "source_file": "docs/journal/2026-08-18-audit-model-and-remediation-plan.md",
      "source_location": "section 7",
      "description": "Six challenges to the existing archive-after-90-days policy: the copy-then-delete pattern is the operation NFR-02 forbids, cascade destroys the audit trail, archive tables lose their controls, 90 days against a five-year floor is a 20:1 mismatch, the volume does not justify archival, and archiving rejected work inverts audit priority.",
      "community": 29,
      "community_name": "Audit Retention and Disposal Model"
    }
